# Secure Local AI Configuration
# Copy this file to .env and fill in the values

# === Security Secrets ===
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here-generate-with-openssl
API_KEY=your-api-key-here-generate-with-openssl
ENCRYPTION_KEY=your-encryption-key-here

# === LLM Configuration ===
# Supports: "ollama", "lmstudio", or "openai-compatible"
LLM_PROVIDER=lmstudio

# LM Studio (OpenAI-compatible API)
LMSTUDIO_HOST=http://localhost:1234
LMSTUDIO_CHAT_MODEL=qwen/qwen3.6-35b-a3b  # id as listed by LM Studio /v1/models
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# Optional reasoning_effort sent with chat requests (none, low, medium, high).
# Thinking models reason by default; "none" keeps short RAG answers fast.
LLM_REASONING_EFFORT=none

# Ollama (if using as alternative)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Generic OpenAI-compatible endpoint
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio  # LM Studio doesn't need real key
# For a separately managed llama-server, set LLM_PROVIDER=openai-compatible,
# OPENAI_BASE_URL to its full API prefix (e.g. http://127.0.0.1:8080/v1),
# and OPENAI_CHAT_MODEL to its served alias. This does not change server flags.
# OPENAI_CHAT_MODEL=qwen-local

# === Server Configuration ===
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allow unauthenticated requests to the internal endpoints (/api/chat,
# /api/read-file, /mcp/*) when they arrive from 127.0.0.1 or ::1. Off by
# default; only enable it when the server is bound to loopback, since a
# reverse proxy on the same host makes remote traffic look local.
ALLOW_LOOPBACK_UNAUTHENTICATED=false

# Comma-separated CORS origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# === File Ingestion ===
MAX_FILE_SIZE_MB=50
MAX_TOTAL_STORAGE_GB=10
DOCUMENTS_PATH=/data/documents
CODE_PATH=/data/code

# === /api/read-file host-path mapping (optional) ===
# Leave HOST_DOCUMENTS_ROOT unset to disable the Windows/host path rewrite.
# HOST_DOCUMENTS_ROOT=/path/to/your/host/documents/folder
CONTAINER_DOCUMENTS_ROOT=/data/documents
# os.pathsep-separated list of extra allowed read prefixes
ALLOWED_PATH_PREFIXES=/data

# === Web Fetcher ===
# The outbound domain allowlist (config/allowed_domains.yaml, falling back to
# the shipped .example file) is enforced fail-closed. Set this to true to skip
# it entirely; the blocklist and all SSRF/IP checks still apply.
ALLOW_ALL_DOMAINS=false
# Tier 3 uses a real browser, which navigates on its own. Off by default.
ALLOW_BROWSER_TIER=false
WEB_FETCH_TIMEOUT=30
WEB_FETCH_MAX_SIZE_MB=5
WEB_FETCH_RATE_LIMIT=10

# === ChromaDB ===
CHROMA_PERSIST_DIR=/data/chroma
CHROMA_COLLECTION_NAME=local_ai_knowledge
